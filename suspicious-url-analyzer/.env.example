# Copy this file to .env.
# Put a real API key only in .env. Never commit .env, and never paste the key into source code.
# This example file is safe to commit because the key is empty.

# Future VirusTotal API key. Leave this empty until live checks are implemented.
VIRUSTOTAL_API_KEY=

# Turn optional reputation checks on or off.
# Accepted enabled values: true, True, 1, yes.
# This step does not send URLs to VirusTotal even when the value is true.
ENABLE_REPUTATION_CHECKS=false
