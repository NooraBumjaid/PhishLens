# Copy this file to .env.
# Put secrets only in .env. Never commit .env, and never paste keys into source code.
# This example file is safe to commit because values are empty/defaults.

# Flask session/CSRF signing key.
# Required when PHISHLENS_ENV=production. Use a unique random value >= 32 characters.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# development | production
PHISHLENS_ENV=development

# Enable Flask debug only for local development (ignored/forced off in production).
FLASK_DEBUG=false

# Optional SQLite path. Default (when empty): database/scans.db next to the app.
# Use a persistent filesystem location in staging/production if history must survive restarts.
DATABASE_PATH=

# Optional VirusTotal API key for explicit reputation lookups (server-side only).
VIRUSTOTAL_API_KEY=

# Turn optional reputation checks on or off.
# Accepted enabled values: true, True, 1, yes, on.
# When enabled and a key is present, reputation lookup still requires an
# explicit "Check Reputation" action. PhishLens does not auto-submit unknown URLs.
ENABLE_REPUTATION_CHECKS=false

# Optional reverse-proxy trust hop count (integer). Leave empty for direct exposure.
# Set to 1 only when a single trusted reverse proxy terminates TLS in front of Gunicorn.
# Never enable this for a process that is directly reachable from the public internet.
TRUST_PROXY_HOPS=
